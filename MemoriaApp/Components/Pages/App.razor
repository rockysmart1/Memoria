@page "/app"
@using MemoriaApp.Components.Models
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>App</PageTitle>
<h1>App page</h1>≈
<div class = "parent-div">
    
    <div><span>Deck count: @deckList.Count</span></div>
    <input placeholder="Deck name.." @bind="newDeck" @bind:event="oninput" @onkeydown="@(e=>
                                                                 {
                                                                     if (e.Key == "Enter") addDeck();
                                                                 })"/>
    
    <button class="btn btn-primary" @onclick="addDeck">Add deck</button>
    <ul>
        @foreach (var deck in deckList)
        {
            <li class = "flex-container child-element">
                <span class = "deckName">@deck.Name Deck Id: @deck.Id</span>
                <a @onclick="()=>deleteDeck(deck)" class = "delete">Delete</a>
            </li>
            

        }
    </ul>

    
</div>


@code {

    private List<DeckModel> deckList = new List<DeckModel>();
    
    protected override async Task OnInitializedAsync()
    {
        await using var context = DbFactory.CreateDbContext();
        deckList = context.Decks.ToList();
        Console.WriteLine("Decks count: " + deckList.Count);
    }    

    private string? newDeck;

    private void deleteDeck(DeckModel deckToDelete)
    {
        using var context = DbFactory.CreateDbContext();
        context.Decks.Remove(deckToDelete);
        context.SaveChanges();
        deckList.Remove(deckToDelete);
    }

    private void addDeck()
    {
        if (!string.IsNullOrWhiteSpace(newDeck))
        {
            var deck = new DeckModel()
            {
                Name = newDeck
            };
            using var context = DbFactory.CreateDbContext();
            context.Decks.Add(deck);
            context.SaveChanges();
            deckList.Add(deck);
            newDeck = "";
        }
    }

}