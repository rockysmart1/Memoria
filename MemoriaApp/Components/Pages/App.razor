@page "/Decks"
@using System.Diagnostics.CodeAnalysis
@using Azure.Core
@using MemoriaApp.Components.Models
@using Microsoft.CodeAnalysis
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>My decks</PageTitle>
<h1>App page</h1>
<div class = "parent-div">
    
    <div class = "column">
        <input class = "input" placeholder="Deck name.." @bind="newDeck" @bind:event="oninput" @onkeydown="@(e=>
                                                                                                           {
                                                                                                               if (e.Key == "Enter") AddDeck();
                                                                                                           })"/>
        <button class="btn btn-primary" @onclick="AddDeck">Add deck</button>
        <ul>
            @foreach (var deck in deckList)
            {
                <li class = "flex-container child-element">
                    
                    @if (deck.deleted_at == null)
                    {
                        <span class = "deckName" @onclick="()=>StartStudy(deck)">@deck.Name</span>
                        <a @onclick="()=>DeleteDeck(deck)" class = "delete">Delete</a>
                    }
                    
                </li>
            }
            <p>Deleted decks:</p>
            @foreach (var deck in deckList)
            {
                <li class = "flex-container child-element">
                    @if (deck.deleted_at != null)
                    {
                        <span class = "deckName">@deck.Name</span>
                        <a @onclick="()=>RestoreDeck(deck)" class = "delete">Restore</a>
                    }
                </li>
            }
        </ul>
    </div>
 
    
    <div class="column">

        @if (studyDeck == null)
        {
            <p> select deck pls</p>
        }
        else
        {
            <p>Current deck: @studyDeck.Name</p>
            <input class = "input" placeholder="Rename deck.." @bind="renameDeckSpace" @bind:event="oninput" @onkeydown="@(e=>
                                                                                                                         {
                                                                                                                             if (e.Key == "Enter") RenameDeck(studyDeck);
                                                                                                                         })"/>
            <button class="btn btn-primary" @onclick="() => RenameDeck(studyDeck)">Rename deck</button>
            <input class="input" placeholder="Front.." @bind="newCardFront" @bind:event="oninput"/>
            <input class="input" placeholder="Back.." @bind="newCardBack" @bind:event="oninput"/>
            <button class="btn btn-primary" @onclick="() => AddCard(studyDeck.Id)">Add card</button>
            
            <ul>
                @foreach (var card in studyDeck.Cards)
                {
                    <li class="flex-container child-element">
                        
                        <p>Front: @card.front_text Back: @card.back_text </p>
                        <a @onclick="() => DeleteCard(card)"> Delete</a>
                        
                        
                    </li>
                }
            </ul>
            
            <div style = "border: 1px solid black; padding: 10px">
                <p> @(studyDeck.Cards.ElementAtOrDefault(cardPosition)?.front_text ?? "no card found" )</p>
                <p>--------</p>
                <p> @(studyDeck.Cards.ElementAtOrDefault(cardPosition)?.back_text ?? "no card found" )</p>
            </div>
            <button @onclick="() => PreviousCard()">Previous Card</button>
            <button @onclick="() => NextCard()">Next Card</button>
            
            
        }


    </div>
    
</div>   


@code {

    private List<DeckModel> deckList = new List<DeckModel>();
    
    protected override async Task OnInitializedAsync()
    {
        await using var context = DbFactory.CreateDbContext();
        deckList = context.Decks.ToList();

    }

    private string? newDeck;
    private string? newCardFront;
    private string? newCardBack;


    private void DeleteDeck(DeckModel deckToDelete)
    {
        using var context = DbFactory.CreateDbContext();
        var deck = context.Decks.Find(deckToDelete.Id);
        if (deck != null)
        {
            deck.deleted_at = DateTime.Now;
            context.SaveChanges();
            deckToDelete.deleted_at = DateTime.Now;
        }
        
    }
    private void RestoreDeck(DeckModel deckToRestore)
    {
        using var context = DbFactory.CreateDbContext();
        var deck = context.Decks.Find(deckToRestore.Id);
        if (deck?.deleted_at != null)
        {
            deck?.deleted_at = null;
            context.SaveChanges();
            deckToRestore.deleted_at = null;
        }
        
    }
    private void AddDeck()
    {
        if (string.IsNullOrWhiteSpace(newDeck)) return;

        var deck = new DeckModel()
        {
        Name = newDeck
        };
        using var context = DbFactory.CreateDbContext();
        context.Decks.Add(deck);
        context.SaveChanges();
        deckList.Add(deck);
        newDeck = "";
    }

    private string? renameDeckSpace;
    
    private void RenameDeck(DeckModel deckToRename)
    {
        if (string.IsNullOrWhiteSpace(renameDeckSpace)) return;
        
        using var context = DbFactory.CreateDbContext();
        var deck = context.Decks.Find(deckToRename.Id);
        
        if (deck != null)
        {
            deck.Name = renameDeckSpace;
            context.SaveChanges();
            deckToRename.Name = renameDeckSpace;
            deckList = context.Decks.ToList();
        }
        
    }
    
    private void DeleteCard(CardModel cardToDelete)
    {
        using var context = DbFactory.CreateDbContext();
        var card = context.Cards.Find(cardToDelete.id);
        if (card != null)
        {
            card.deleted_at = DateTime.Now;
            context.SaveChanges();
        }

        if (studyDeck != null)
        {
            studyDeck = ReloadDeck(studyDeck.Id);
        }
    }
    
    
    private void AddCard(int deckIdLink)
    {
        if (string.IsNullOrWhiteSpace(newCardFront) && string.IsNullOrWhiteSpace(newCardBack)) return;
        
        var card = new CardModel()
        {
            front_text = newCardFront,
            back_text = newCardBack,
            deck_id = deckIdLink
        };
        using var context = DbFactory.CreateDbContext();
        context.Cards.Add(card);
        context.SaveChanges();
        studyDeck = ReloadDeck(deckIdLink);
        newCardFront = "";
        newCardBack = "";
        
    }
    
    public DeckModel? studyDeck;
    public void StartStudy(DeckModel deckToStudy)
    {
        studyDeck = ReloadDeck(deckToStudy.Id);
        
    }

    private DeckModel ReloadDeck(int deckId)
    {
        cardPosition = 0;
        using var context = DbFactory.CreateDbContext();
        var deck = context.Decks
            .Include(d => d.Cards.Where(c => c.deleted_at == null))
            .First(d => d.Id == deckId);

        return deck;
    }
    private int cardPosition = 0;
    
    private void NextCard()
    {
        if (cardPosition < studyDeck?.Cards.Count - 1)
        {
            cardPosition++;
        }
        
    }
    
    private void PreviousCard()
    {
        if (cardPosition > 0)
        {
            cardPosition--;
        }
        
    }
}






