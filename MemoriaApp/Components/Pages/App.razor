@page "/Decks"
@using Azure.Core
@using MemoriaApp.Components.Models
@using Microsoft.CodeAnalysis
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>My decks</PageTitle>
<h1>App page</h1>
<div class = "parent-div">
    
    <div class = "column">
        <input class = "input" placeholder="Deck name.." @bind="newDeck" @bind:event="oninput" @onkeydown="@(e=>
                                                                                                           {
                                                                                                               if (e.Key == "Enter") AddDeck();
                                                                                                           })"/>
        <button class="btn btn-primary" @onclick="AddDeck">Add deck</button>
        <ul>
            @foreach (var deck in deckList)
            {
                <li class = "flex-container child-element">
                    <span class = "deckName" @onclick="()=>StartStudy(deck)">@deck.Name</span>
                    <a @onclick="()=>DeleteDeck(deck)" class = "delete">Delete</a>
                </li>
            }
        </ul>
    </div>
 
    
    <div class="column">
        <form>
            <select>
                @foreach (var deck in deckList)
                 {
                <option @bind="deckDropdown" @bind:event="oninput" value=@(deck)>@deck.Name</option>
                }
            </select>`
        </form>
        
        <p>deck dropdown text: @deckDropdown</p>

        @if (studyDeck == null)
        {
            <p> select deck pls</p>
        }
        else
        {
            <p>Current deck: @studyDeck?.Name</p>
            <input class="input" placeholder="Front.." @bind="newCardFront" @bind:event="oninput"/>
            <input class="input" placeholder="Back.." @bind="newCardBack" @bind:event="oninput"/>
            <button class="btn btn-primary" @onclick="() => AddCard(studyDeck.Id)">Add card</button>

            <ul>
                @foreach (var card in studyDeck.Cards)
                {
                    <li class="flex-container child-element">
                        <p>Front: @card.front_text Back: @card.back_text </p>
                    </li>
                }

            </ul>
        }


    </div>
    
</div>   


@code {

    private List<DeckModel> deckList = new List<DeckModel>();
    
    protected override async Task OnInitializedAsync()
    {
        await using var context = DbFactory.CreateDbContext();
        deckList = context.Decks.ToList();
    }

    private string? newDeck;
    private string? newCardFront;
    private string? newCardBack;
    private DeckModel? deckDropdown;

    private void DeleteDeck(DeckModel deckToDelete)
    {
        using var context = DbFactory.CreateDbContext();
        context.Decks.Remove(deckToDelete);
        context.SaveChanges();
        deckList.Remove(deckToDelete);
    }

    private void AddDeck()
    {
        if (!string.IsNullOrWhiteSpace(newDeck))
        {
            var deck = new DeckModel()
            {
                Name = newDeck
            };
            using var context = DbFactory.CreateDbContext();
            context.Decks.Add(deck);
            context.SaveChanges();
            deckList.Add(deck);
            newDeck = "";
        }
    }
    private void AddCard(int deckIdLink)
    {
        if (!string.IsNullOrWhiteSpace(newCardFront) && !string.IsNullOrWhiteSpace(newCardBack))
        {
            var card = new CardModel()
            {
                front_text = newCardFront,
                back_text = newCardBack,
                deck_id = deckIdLink
            };
            using var context = DbFactory.CreateDbContext();
            context.Cards.Add(card);
            context.SaveChanges();
            studyDeck = ReloadDeck(deckIdLink);
            newCardFront = "";
            newCardBack = "";
        }
    }
    
    public DeckModel? studyDeck;
    public void StartStudy(DeckModel deckToStudy)
    {
        // Navigation.NavigateTo($"Study/{deckToStudy.Id}");
        studyDeck = ReloadDeck(deckToStudy.Id);
    }

    private DeckModel ReloadDeck(int deckId)
    {
        using var context = DbFactory.CreateDbContext();
        var deck = context.Decks
            .Include(d => d.Cards)
            .First(d => d.Id == deckId);
        return deck;
    }
}






